<section id="projects" class="section projects-section">
  <h2 class="section-title">Projects</h2>

  <!-- NES Theme -->
  <div data-theme-target="nes">
    <h3 class="subsection-title">Main Projects</h3>

    {% for project in cv.projects.featured %}
    {% set link = project.url or project.urls.live or project.urls.source %}
    <div class="nes-container is-rounded">
      <h4>{{ project.name }}</h4>
      <p class="nes-text is-primary">{{ project.type }}</p>
      <p>{{ project.description }}</p>

      {% if project.features %}
      <h5>Features:</h5>
      <ul class="nes-list is-disc">
        {% for feature in project.features %}
        <li>{{ feature }}</li>
        {% endfor %}
      </ul>
      {% endif %}

      <div class="project-meta">
        <span class="nes-badge">
          <span class="is-dark">{{ project.status }}</span>
        </span>
        {% for tech in project.technologies %}
        <span class="nes-badge">
          <span class="is-warning">{{ tech }}</span>
        </span>
        {% endfor %}
      </div>

      {% if link %}
      <a href="{{ link }}" target="_blank" rel="noopener" class="nes-btn">Open</a>
      {% endif %}
    </div>
    {% endfor %}

    <h3 class="subsection-title">University Projects</h3>

    {% for project in cv.projects.university %}
    {% set link = project.url or project.urls.live or project.urls.source %}
    <div class="nes-container">
      <h4>{{ project.name }}</h4>
      <p class="nes-text is-primary">{{ project.type }}</p>
      <p>{{ project.description }}</p>
      {% if project.technologies %}
      <p class="nes-text is-disabled">Tech: {{ project.technologies | join }}</p>
      {% endif %}
      {% if link %}
      <a href="{{ link }}" target="_blank" rel="noopener" class="nes-btn">Open</a>
      {% endif %}
    </div>
    {% endfor %}

    <h3 class="subsection-title">Other Public Projects</h3>

    {% for project in cv.projects.public %}
    {% set link = project.url or project.urls.live or project.urls.source %}
    <div class="nes-container">
      <h4>{{ project.name }}</h4>
      <p class="nes-text is-primary">{{ project.type }}</p>
      <p>{{ project.description }}</p>
      {% if project.technologies %}
      <p class="nes-text is-disabled">Tech: {{ project.technologies | join }}</p>
      {% endif %}
      {% if link %}
      <a href="{{ link }}" target="_blank" rel="noopener" class="nes-btn">Open</a>
      {% endif %}
    </div>
    {% endfor %}
  </div>

  <!-- 98 Theme -->
  <div data-theme-target="98">
    <h3 class="subsection-title">Main Projects</h3>

    {% for project in cv.projects.featured %}
    {% set link = project.url or project.urls.live or project.urls.source %}
    <div class="window">
      <div class="title-bar">
        <div class="title-bar-text">{{ project.name }}</div>
      </div>
      <div class="window-body">
        <p><strong>{{ project.type }}</strong></p>
        <p>{{ project.description }}</p>

        {% if project.features %}
        <fieldset>
          <legend>Features</legend>
          <ul>
            {% for feature in project.features %}
            <li>{{ feature }}</li>
            {% endfor %}
          </ul>
        </fieldset>
        {% endif %}

        {% if link %}
        <button onclick="window.open('{{ link }}', '_blank')">Open</button>
        {% endif %}

        <div class="status-bar">
          <p class="status-bar-field">{{ project.status }}</p>
          <p class="status-bar-field">Tech: {{ project.technologies | join }}</p>
        </div>
      </div>
    </div>
    {% endfor %}

    <h3 class="subsection-title">University Projects</h3>

    {% for project in cv.projects.university %}
    {% set link = project.url or project.urls.live or project.urls.source %}
    <div class="window">
      <div class="title-bar">
        <div class="title-bar-text">{{ project.name }}</div>
      </div>
      <div class="window-body">
        <p><strong>{{ project.type }}</strong></p>
        <p>{{ project.description }}</p>
        {% if project.technologies %}
        <p>Technologies: {{ project.technologies | join }}</p>
        {% endif %}
        {% if link %}
        <button onclick="window.open('{{ link }}', '_blank')">Open</button>
        {% endif %}
      </div>
    </div>
    {% endfor %}

    <h3 class="subsection-title">Other Public Projects</h3>

    {% for project in cv.projects.public %}
    {% set link = project.url or project.urls.live or project.urls.source %}
    <div class="window">
      <div class="title-bar">
        <div class="title-bar-text">{{ project.name }}</div>
      </div>
      <div class="window-body">
        <p><strong>{{ project.type }}</strong></p>
        <p>{{ project.description }}</p>
        {% if project.technologies %}
        <p>Technologies: {{ project.technologies | join }}</p>
        {% endif %}
        {% if link %}
        <button onclick="window.open('{{ link }}', '_blank')">Open</button>
        {% endif %}
      </div>
    </div>
    {% endfor %}
  </div>
</section>
